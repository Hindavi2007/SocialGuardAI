# SocialGuard AI Configuration Environment Variables

# Backend Secret & Authentication

SECRET_KEY=replace-with-a-secure-secret-key
JWT_SECRET_KEY=replace-with-a-secure-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24
PORT=5000

# Database Configuration
# Options for DB_TYPE:
# - 'auto': Tries connecting to MySQL; if unreachable, gracefully falls back to local SQLite
# - 'mysql': Connects to MySQL database specified below
# - 'sqlite': Uses local SQLite file (backend/socialguard.db)
DB_TYPE=auto

# MySQL Settings (used if DB_TYPE=mysql or auto)
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=socialguard_db

# Optional direct database connection string (overrides above if set)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/socialguard_db
